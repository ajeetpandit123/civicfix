# Application
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://civicfix:civicfix@localhost:5432/civicfix?schema=public

# Auth (generate long random strings; never commit real secrets)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# Optional Redis for background jobs (in-process fallback is used if omitted)
REDIS_URL=redis://localhost:6379

# Object storage: "local" (dev) or "s3"
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# AI: "none" | "openai" | "mock"
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000

# Email: "console" | "smtp"
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CivicFix <noreply@civicfix.local>

# Maps / geocoding: "nominatim" | "none"
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=CivicFix/0.1 (demo; replace in production)

# Cookie
COOKIE_SECURE=false
